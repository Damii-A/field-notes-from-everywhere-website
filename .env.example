# Copy to .env.local and fill in real values. Never commit .env.local — see .gitignore.
# See ARCHITECTURE.md §12 for what each of these is for.

# --- Sanity -------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Kit (ConvertKit) -----------------------------------------------------
# Kit holds ONLY confirmed, converted Reading Room members — see
# ARCHITECTURE.md §9 and DECISIONS.md 2026-09-22 ("Kit holds only confirmed
# Reading Room members, never trial-only signups"). Nothing else touches
# Kit; the free list lives in Resend's own contacts instead (below).
KIT_API_KEY=
# Durable "confirmed Reading Room member" tag — applied only by the Paddle
# webhook at actual conversion, removed on cancellation.
KIT_READING_ROOM_TAG_ID=

# --- Paddle -----------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle.js runs client-side checkout, so both the client token and the
# Price ID it checks out against must be public (NEXT_PUBLIC_) — neither is
# a secret; Paddle's own client-side SDK is designed to ship these to the
# browser. PADDLE_API_KEY/PADDLE_WEBHOOK_SECRET above stay server-only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_READING_ROOM_PRICE_ID=

# --- Resend --------------------------------------------------------------
# Everything: transactional "send this list to me" email, the free-list
# contacts (below), the weekly recap, and the Reading Room trial's
# Automations sequence. See ARCHITECTURE.md §9.
RESEND_API_KEY=
# Free-list source-attribution segments (Resend's replacement for
# Audiences — see DECISIONS.md 2026-09-22, "Move the free list from Kit to
# Resend contacts"). Create via resend.segments.create({name}) or the
# dashboard; contacts are global, so no Audience is required.
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_SEND_LIST_SEGMENT_ID=

# --- Site -----------------------------------------------------------
# Server-only (used by sitemap.xml/robots.ts/feed.xml route handlers, never
# in browser code) — deliberately not NEXT_PUBLIC_, since Vercel flags/blocks
# public variables whose value looks like it could be sensitive, and this
# doesn't need to be in the client bundle anyway.
SITE_URL=http://localhost:3000

# --- Cron ------------------------------------------------------------
# An internal shared secret (not tied to any external account) that
# verifies requests to /api/cron/weekly-recap actually came from Vercel's
# Cron scheduler, not a public/anonymous caller. Vercel sends this
# automatically as `Authorization: Bearer <value>` once the same value is
# set in the project's Vercel env vars — see ARCHITECTURE.md §9. Generate
# any long random string (e.g. `openssl rand -hex 24`).
CRON_SECRET=

# Copy to .env.local and fill in real values. Never commit .env.local — see .gitignore.
# See ARCHITECTURE.md §12 for what each of these is for.

# --- Sanity -------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Kit (ConvertKit) -----------------------------------------------------
# Kit tracks list/segment state only — see ARCHITECTURE.md §9. All actual
# multi-step sending (the Reading Room trial included) is Resend's job now.
KIT_API_KEY=
# A Kit form originally created for the Reading Room trial signup — no
# longer called by app code (the trial sequence moved to Resend Automations,
# see DECISIONS.md 2026-09-22). Left here since it's harmless if unset/unused.
KIT_READING_ROOM_FORM_ID=
# Durable "has an active Reading Room relationship" (membership) tag —
# applied at trial start and by the Paddle webhook on conversion, removed on
# cancellation.
KIT_READING_ROOM_TAG_ID=
# Source-attribution tags for the two general free-list entry points.
KIT_NEWSLETTER_TAG_ID=
KIT_SEND_LIST_TAG_ID=

# --- Paddle -----------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle.js runs client-side checkout, so both the client token and the
# Price ID it checks out against must be public (NEXT_PUBLIC_) — neither is
# a secret; Paddle's own client-side SDK is designed to ship these to the
# browser. PADDLE_API_KEY/PADDLE_WEBHOOK_SECRET above stay server-only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_READING_ROOM_PRICE_ID=

# --- Resend --------------------------------------------------------------
# Transactional "send this list to me" email, and (as of 2026-09-22) the
# Reading Room trial's Automations sequence. See ARCHITECTURE.md §9.
RESEND_API_KEY=

# --- Site -----------------------------------------------------------
# Server-only (used by sitemap.xml/robots.ts/feed.xml route handlers, never
# in browser code) — deliberately not NEXT_PUBLIC_, since Vercel flags/blocks
# public variables whose value looks like it could be sensitive, and this
# doesn't need to be in the client bundle anyway.
SITE_URL=http://localhost:3000

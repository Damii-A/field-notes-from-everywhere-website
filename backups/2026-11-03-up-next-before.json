    "children": [
     {
      "_key": "d71859de2bde",
      "_type": "span",
      "marks": [],
      "text": "Maybe it’s whether a character can be trusted. Maybe it’s whether one clue changes how you see everything that came before it. Either way, these 12 books will give you plenty of material for theories, predictions, and strong opinions."
     }
    ],
    "markDefs": [],
    "style": "normal"
   },

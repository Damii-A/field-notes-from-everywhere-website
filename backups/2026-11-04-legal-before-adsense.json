    "_type": "block",
    "children": [
     {
      "_key": "b0cb9dfbe88b",
      "_type": "span",
      "marks": [],
      "text": "Questions or requests about your privacy: "
     },
     {
      "_key": "9242f4a40df0",
      "_type": "span",

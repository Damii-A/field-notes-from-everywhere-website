  "introText": [
   {
    "_key": "d8e75d6c5b5c",
    "_type": "block",
    "children": [
     {
      "_key": "671f8f7bb383",
      "_type": "span",
      "marks": [],
      "text": "With millions of thrillers out there, finding one worth reading can be a challenge. So we analyzed thousands of real thriller book recommendations to see which books had the most organic mentions."
     }
    ],
    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "2fa8fb5b1dec",
    "_type": "block",
    "children": [
     {
      "_key": "681f45f4b2bb",
      "_type": "span",
      "marks": [],
      "text": "Some of the results probably won’t surprise you. "
     },
     {
      "_key": "470e32d16388",
      "_type": "span",
      "marks": [
       "em"
      ],
      "text": "Gone Girl"
     },
     {
      "_key": "67d697d045e3",
      "_type": "span",
      "marks": [],
      "text": " has been everywhere for years, and "
     },
     {
      "_key": "7bfde436892b",
      "_type": "span",
      "marks": [
       "em"
      ],
      "text": "The Silent Patient"
     },
     {
      "_key": "eb69f275230b",
      "_type": "span",
      "marks": [],
      "text": " is hardly a hidden gem. But keep going, and you might find a few hidden gems."
     }
    ],
    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "fd72af903d58",
    "_type": "block",
    "children": [
     {
      "_key": "8d534429b1e7",
      "_type": "span",
      "marks": [],
      "text": "There are old favorites, newer hits, and a few great thrillers that don’t get nearly as much mainstream attention as they deserve. Enjoy!"
     }
    ],
    "markDefs": [],
    "style": "normal"
   }
  ],
